{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "youtube-dialogue-studio-integration",
  "compatibility_date": "2026-08-08",
  "main": "./src/worker/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "GENERATION_SESSION",
        "class_name": "GenerationSession"
      }
    ]
  },
  "exports": {
    "GenerationSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "GEMINI_MODEL": "gemini-test"
  }
}
